    <metadaten>
      <jurabk>TestG</jurabk>
      <enbez>§ 1</enbez>
      <titel format="parat">Zweck</titel>
    </metadaten>
    <textdaten><text format="XML"><Content>
      <P>(1) Dieses Gesetz regelt den Umgang mit Messgeräten in Werkstätten.</P>
      <P>(2) Es gilt nicht für Messgeräte im Haushalt.</P>
    </Content></text></textdaten>
  </norm>
